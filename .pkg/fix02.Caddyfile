# Caddy on host networking.
#
# The shop answers on 80 under its own name, and on 8080 for any name so IP-based scripts and
# checks keep working. Hostless on 8080, host-matched on 80.
#
# The checkout .git directory is no longer served on either port.

:80 {
	bind {$LAB_IP}

	@myshop host vibeshop.test {$LAB_IP}

	handle @myshop {
		reverse_proxy {$LAB_IP}:3000 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy {$LAB_IP}:8081 {
			header_up Host {host}
		}
	}
}

:8080 {
	bind {$LAB_IP}

	handle {
		reverse_proxy {$LAB_IP}:3000 {
			header_up Host {host}
		}
	}
}
